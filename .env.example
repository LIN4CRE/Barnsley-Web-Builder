# ---------------------------------------------------------------------------
# Google Gemini API key — enables the AI features (pitch, research, scanner).
#
# Without it the app still works: every AI feature falls back to a local,
# deterministic template and the UI labels it as such.
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model used for generation. Defaults to gemini-2.5-flash.
# GEMINI_MODEL="gemini-2.5-flash"

# Port the Express server binds to. Defaults to 3000.
# PORT=3000

# Set to "production" to serve the built SPA from dist/ and enable strict CSP + HSTS.
# NODE_ENV=production
